# dados brutos e processados — nunca versionados, em qualquer profundidade (T0.1:
# "datasets/raw/" sem "**/" ficava ancorado na raiz e deixou passar 459 MB do E07)
**/datasets/raw/
**/datasets/processed/

# literature/pdf/ É versionado: o repositório é privado e os PDFs são material
# de leitura do doutorado. Se este repositório algum dia virar público, os PDFs
# de editora precisam sair do histórico antes — não basta apagar o arquivo.
bench/captures/**/*.bin
bench/captures/**/*.csv
!bench/captures/**/README.md

# python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# resultados grandes (metrics.csv e manifest.json SÃO versionados)
# As figuras PNG SAO versionadas: o relatorio em Markdown as embute, e imagem
# ignorada vira imagem quebrada no GitHub. Sao ~1,3 MB no total. O PDF vetorial
# continua sendo o que vai para o paper.
!experiments/**/figures/*.png
experiments/**/results*/*.npz
experiments/**/results*/*.h5

# zephyr / ncs
build/
firmware/**/build/

