# raw and processed datasets are never versioned, at any depth; download them as described in
# REPRODUCE.md and datasets/manifests/
**/datasets/raw/
**/datasets/processed/

# python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# large intermediate results (metrics.csv and manifest.json ARE versioned)
experiments/**/results*/*.npz
experiments/**/results*/*.h5
# E15 on Paderborn: metrics.csv (31 MB) is versioned compressed as metrics.csv.gz, with the same
# content; the per-run JSON files (runs/) are not released
experiments/E15-learned-sampling-mask/results-paderborn/metrics.csv
experiments/E15-learned-sampling-mask/results-paderborn/runs/

# local TeX Live (papers/shared/build_pdf.py install), never on the system PATH
.tools/

# latex
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.spl
*.tdo
# the paper PDFs are built by papers/shared/build_pdf.py from the versioned sources
papers/*/main*.pdf

# os
.DS_Store
Thumbs.db
